# CodePilot AI Backend Configuration Example
# Copy this file to .env and configure your environment variables.

# HTTP listening port
PORT=3001

# Allowed frontend origins for CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Project root directory for controlled file inspection and editing (defaults to workspace root)
PROJECT_ROOT=

# PostgreSQL Connection String (leave empty for automatic local JSON-file fallback)
# Format: postgresql://username:password@localhost:5432/codepilot
DATABASE_URL=

# Groq API Configuration
# Get an API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Session Secret (change to a strong random string in production)
SESSION_SECRET=codepilot-dev-secret-change-in-production

# Environment Mode
NODE_ENV=development
